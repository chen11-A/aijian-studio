            "$ref": "#/components/schemas/ReviewSubmissionData"
          }
        },
        "required": ["submission", "head"],
        "title": "ReviewSubmissionResultData",
        "type": "object"
      },
      "RoleSignoffData": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "gate": {
            "enum": ["G1", "G2"],
            "title": "Gate",
            "type": "string"
          },
          "id": {
            "pattern": "^sig_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
