            "type": "array"
          }
        },
        "required": ["signoffs", "head"],
        "title": "ReviewSignoffResultData",
        "type": "object"
      },
      "ReviewSubmissionData": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "gate": {
            "enum": ["G1", "G2"],
            "title": "Gate",
            "type": "string"
          },
          "id": {
            "pattern": "^sub_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
