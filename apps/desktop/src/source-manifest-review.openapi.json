{
  "components": {
    "schemas": {
      "ArtifactHeadData": {
        "additionalProperties": false,
        "properties": {
          "accepted_version_id": {
            "anyOf": [
              {
                "pattern": "^ver_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accepted Version Id"
          },
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "latest_version_id": {
            "pattern": "^ver_[0-9a-f]{32}$",
            "title": "Latest Version Id",
            "type": "string"
          },
          "review_evidence_revision": {
            "minimum": 0,
            "title": "Review Evidence Revision",
            "type": "integer"
          },
          "review_submission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Submission Id"
          },
          "review_version_id": {
            "anyOf": [
              {
                "pattern": "^ver_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Version Id"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "latest_version_id",
          "review_submission_id",
          "revision",
          "review_evidence_revision",
          "updated_at"
        ],
        "title": "ArtifactHeadData",
        "type": "object"
      },
      "ConfirmationChallengeData": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": ["submit", "signoff", "decision"],
            "title": "Action",
            "type": "string"
          },
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "consumed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "gate": {
            "enum": ["G1", "G2"],
            "title": "Gate",
            "type": "string"
          },
          "head_revision": {
            "minimum": 1,
            "title": "Head Revision",
            "type": "integer"
          },
          "id": {
            "pattern": "^chg_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "readiness_report_id": {
            "pattern": "^rpt_[0-9a-f]{32}$",
            "title": "Readiness Report Id",
            "type": "string"
          },
          "review_evidence_revision": {
            "minimum": 0,
            "title": "Review Evidence Revision",
            "type": "integer"
          },
          "version_id": {
            "pattern": "^ver_[0-9a-f]{32}$",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "version_id",
          "gate",
          "action",
          "readiness_report_id",
          "head_revision",
          "review_evidence_revision",
          "expires_at",
          "consumed_at",
          "created_at"
        ],
        "title": "ConfirmationChallengeData",
        "type": "object"
      },
      "ConfirmationRequest": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "pattern": "^chg_[0-9a-f]{32}$",
            "title": "Challenge Id",
            "type": "string"
          },
          "confirmation_token": {
            "maxLength": 256,
            "minLength": 20,
            "title": "Confirmation Token",
            "type": "string"
          }
        },
        "required": ["challenge_id", "confirmation_token"],
        "title": "ConfirmationRequest",
        "type": "object"
      },
      "EmptyActionRequest": {
        "additionalProperties": false,
        "properties": {},
        "title": "EmptyActionRequest",
        "type": "object"
      },
      "GateDecisionData": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "actor_role": {
            "title": "Actor Role",
            "type": "string"
          },
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "decided_at": {
            "format": "date-time",
            "title": "Decided At",
            "type": "string"
          },
          "decision": {
            "enum": ["approved", "approved_with_waiver", "rejected"],
            "title": "Decision",
            "type": "string"
          },
          "gate": {
            "enum": ["G1", "G2"],
            "title": "Gate",
            "type": "string"
          },
          "id": {
            "pattern": "^dec_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "readiness_report_id": {
            "pattern": "^rpt_[0-9a-f]{32}$",
            "title": "Readiness Report Id",
            "type": "string"
          },
          "self_review": {
            "title": "Self Review",
            "type": "boolean"
          },
          "submission_id": {
            "pattern": "^sub_[0-9a-f]{32}$",
            "title": "Submission Id",
            "type": "string"
          },
          "version_id": {
            "pattern": "^ver_[0-9a-f]{32}$",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "version_id",
          "submission_id",
          "gate",
          "decision",
          "readiness_report_id",
          "actor_id",
          "actor_role",
          "self_review",
          "rationale",
          "decided_at"
        ],
        "title": "GateDecisionData",
        "type": "object"
      },
      "GateDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "pattern": "^chg_[0-9a-f]{32}$",
            "title": "Challenge Id",
            "type": "string"
          },
          "confirmation_token": {
            "maxLength": 256,
            "minLength": 20,
            "title": "Confirmation Token",
            "type": "string"
          },
          "decision": {
            "const": "approved",
            "title": "Decision",
            "type": "string"
          },
          "rationale": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": ["challenge_id", "confirmation_token", "decision", "rationale"],
        "title": "GateDecisionRequest",
        "type": "object"
      },
      "GateDecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GateDecisionResultData"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": ["data", "request_id"],
        "title": "GateDecisionResponse",
        "type": "object"
      },
      "GateDecisionResultData": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/GateDecisionData"
          },
          "head": {
            "$ref": "#/components/schemas/ArtifactHeadData"
          }
        },
        "required": ["decision", "head"],
        "title": "GateDecisionResultData",
        "type": "object"
      },
      "GateReadinessReportData": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^art_[0-9a-f]{32}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "gate": {
            "enum": ["G1", "G2"],
            "title": "Gate",
            "type": "string"
          },
          "head_revision": {
            "minimum": 1,
            "title": "Head Revision",
            "type": "integer"
          },
          "id": {
            "pattern": "^rpt_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "policy_code": {
            "title": "Policy Code",
            "type": "string"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "report_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Report Hash",
            "type": "string"
          },
          "review_evidence_revision": {
            "minimum": 0,
            "title": "Review Evidence Revision",
            "type": "integer"
          },
          "submission_id": {
            "anyOf": [
              {
                "pattern": "^sub_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Submission Id"
          },
          "version_id": {
            "pattern": "^ver_[0-9a-f]{32}$",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "version_id",
          "gate",
          "policy_code",
          "policy_version",
          "head_revision",
          "review_evidence_revision",
          "report",
          "report_hash",
          "expires_at",
          "created_at"
        ],
        "title": "GateReadinessReportData",
        "type": "object"
      },
      "PrepareGateDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "const": "approved",
            "title": "Decision",
            "type": "string"
          },
          "rationale": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "readiness_report_id": {
            "pattern": "^rpt_[0-9a-f]{32}$",
            "title": "Readiness Report Id",
            "type": "string"
          }
        },
        "required": ["decision", "rationale", "readiness_report_id"],
        "title": "PrepareGateDecisionRequest",
        "type": "object"
      },
      "PreparedReviewActionData": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "$ref": "#/components/schemas/ConfirmationChallengeData"
          },
          "confirmation_token": {
            "title": "Confirmation Token",
            "type": "string"
          },
          "report": {
            "$ref": "#/components/schemas/GateReadinessReportData"
