            "type": "string"
          }
        },
        "required": ["data", "request_id"],
        "title": "PreparedReviewActionResponse",
        "type": "object"
      },
      "ReviewSignoffResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReviewSignoffResultData"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": ["data", "request_id"],
        "title": "ReviewSignoffResponse",
        "type": "object"
      },
      "ReviewSignoffResultData": {
        "additionalProperties": false,
        "properties": {
          "head": {
            "$ref": "#/components/schemas/ArtifactHeadData"
          },
          "signoffs": {
            "items": {
              "$ref": "#/components/schemas/RoleSignoffData"
            },
