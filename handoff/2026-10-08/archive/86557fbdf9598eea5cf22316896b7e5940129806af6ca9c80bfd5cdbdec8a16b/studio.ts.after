  createProposalRun(
    projectId: string,
    command: ProposalRunCreateCommand,
  ): Promise<ProposalRunCreateResult>;
  createRemoteSourceExtractRun?: RemoteSourceExtractCapability["create"];
  readOriginalRemoteSourceExtractRun?: RemoteSourceExtractCapability["readOriginal"];
  createSub2APISourceExtractRun?: Sub2APISourceExtractCapability["create"];
  readOriginalSub2APISourceExtractOperation?: Sub2APISourceExtractCapability["readOriginal"];
  approveSub2APISourceExtractCall?: Sub2APISourceExtractCapability["approve"];
  getSub2APISourceExtractApproval?: Sub2APISourceExtractCapability["readApproval"];
  getSourceExtraction?: (projectId: string) => Promise<SourceExtractionReadResult>;
  getSourceExtractionVersion?: (projectId: string, versionId: string) =>
    Promise<SourceExtractionReadResult>;
  createFakeTimelineRun(
    projectId: string,
