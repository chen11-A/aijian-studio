+    {journal.kind === "BLOCKED" && <p role="alert">本地项目更新记录不可读取，已阻止保存。</p>}
+    {journal.kind === "PENDING" && <p role="alert">已有结果未知的项目更新，不会自动重试。</p>}
+    {notice && <p role="status">{notice}</p>}
+  </div>;
+}
