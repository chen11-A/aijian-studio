{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIVORA 智能体角色文件",
  "description": "每个角色一个文件：系统提示词（含输出格式说明）、输入格式、输出格式（都带 JSON Schema）、软件里读它的解析器和 3 个示例。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "role",
    "name",
    "version",
    "summary",
    "pipeline",
    "batching",
    "attach_images",
    "app_parsers",
    "system_prompt",
    "input_format",
    "output_format",
    "examples"
  ],
  "properties": {
    "$schema": { "const": "../schema/role-file.schema.json" },
    "format_version": { "const": 2 },
    "role": {
      "enum": [
        "writer",
        "art",
        "director",
        "performance",
        "action",
        "sound",
        "continuity",
        "review"
      ]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 8 },
    "version": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 4, "maxLength": 80 },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "reads_from", "feeds"],
      "properties": {
        "step": { "type": "integer", "minimum": 1, "maximum": 20 },
        "reads_from": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 30 }
        },
        "feeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      }
    },
    "batching": { "type": "string", "minLength": 4, "maxLength": 80 },
    "attach_images": { "type": "boolean" },
    "app_parsers": {
      "description": "软件里读这个角色回复的函数，以及它们读哪些字段。新字段只是附加，不影响这些函数。",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 4, "maxLength": 200 }
    },
    "system_prompt": {
      "description": "按行保存，使用时用换行符连接，原样作为系统提示词，没有占位符。「输出格式：」的下一行是输出的 JSON 骨架。连起来不超过 3000 字。",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    },
    "input_format": { "$ref": "#/$defs/format" },
    "output_format": { "$ref": "#/$defs/format" },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "input", "output"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+-[1-3]$" },
          "title": { "type": "string", "minLength": 4, "maxLength": 60 },
          "input": { "type": "object" },
          "output": { "type": ["object", "array"] }
        }
      }
    }
  },
  "$defs": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "schema"],
      "properties": {
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "schema": { "type": "object" }
      }
    }
  }
}
