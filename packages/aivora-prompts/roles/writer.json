                "speaker": "林晚",
                "kind": "对白",
                "line": "我爸欠他的钱，早就还清了。",
                "delivery": "声音发紧",
                "source": "P07"
              },
              {
                "type": "dialogue",
                "speaker": "沈砚",
                "kind": "对白",
                "line": "他要的不是钱。",
                "delivery": null,
                "source": "P08"
              },
              {
                "type": "action",
                "text": "沈砚把塑料袋塞进林晚怀里。",
                "source": "P08"
              },
              {
                "type": "dialogue",
                "speaker": "沈砚",
                "kind": "对白",
                "line": "这是你爸的账本。拿好，别让任何人看见。",
                "delivery": null,
                "source": "P08"
              },
              {
                "type": "action",
                "text": "一道车灯扫过橱窗。雨幕里，穿灰色风衣的周烈撑着黑伞站在台阶下，嘴角叼着一根没点着的烟。",
                "source": "P09"
              },
              {
                "type": "action",
                "text": "周烈抬起手，用指节在玻璃门上敲了三下。",
                "source": "P10"
              },
              {
                "type": "action",
                "text": "沈砚示意林晚退到柜台后面。",
                "source": "P10"
              }
            ]
          },
          {
            "scene_id": "S02",
            "no": 2,
            "heading": {
              "place": "旧书店",
              "spot": "门口屋檐下",
              "interior": false,
              "time": "夜里十点",
              "weather": "大雨"
            },
            "title": "檐下对峙",
            "characters": ["沈砚", "周烈", "林晚"],
            "source_paragraphs": ["P11", "P12", "P13", "P14", "P15", "P16"],
            "summary": "周烈隔着雨帘施压，想进门被沈砚挡回，约他凌晨一点去三号码头。",
            "mood": "悬疑",
            "est_seconds": 40,
            "elements": [
              {
                "type": "action",
                "text": "沈砚推开门，走到屋檐下。檐口的雨水在他和周烈之间挂成一道水帘。",
                "source": "P11"
              },
              {
                "type": "dialogue",
                "speaker": "周烈",
                "kind": "对白",
                "line": "沈警官，好久不见。",
                "delivery": "笑着说",
                "source": "P12"
              },
              {
                "type": "dialogue",
                "speaker": "周烈",
                "kind": "对白",
                "line": "书店的房租，我已经替林小姐交到明年了。",
