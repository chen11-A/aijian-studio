              {
                "take_id": "S02-06-T2",
                "label": "B",
                "seconds": 8,
                "frames": [
                  {
                    "image": "<IMAGE_11>",
                    "at_seconds": 1
                  },
                  {
                    "image": "<IMAGE_12>",
