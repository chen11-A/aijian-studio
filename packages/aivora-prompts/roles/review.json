            }
          },
          {
            "shot_id": "S02-06",
            "takes": [
              {
                "take_id": "S02-06-T1",
                "seen_frames": true,
                "checks": {
                  "identity": "过",
                  "action": "过",
                  "artifacts": "过",
                  "continuity": "不过"
                },
                "verdict": "必须重做",
                "issues": [
                  {
                    "kind": "接不上",
                    "source": "看画面",
                    "start_seconds": 0.8,
                    "end_seconds": 3.2,
                    "note": "烟头是红的还在冒烟，前面写的是没点着的烟"
                  }
                ]
              },
              {
                "take_id": "S02-06-T2",
                "seen_frames": true,
                "checks": {
                  "identity": "过",
                  "action": "过",
                  "artifacts": "过",
                  "continuity": "过"
                },
                "verdict": "可用",
                "issues": []
              }
            ],
            "recommend": {
              "take_id": "S02-06-T2",
              "reason": "B 的烟没点着，磕烟和抬眼都清楚。"
            },
            "next_try": null
          }
        ]
      }
    },
    {
      "id": "review-2",
      "title": "第二章打斗三个镜头共七版，正好 14 张帧图：右臂受伤、钢管变形、六根手指",
      "input": {
        "task": "review_takes",
        "attached_images": 14,
        "shots": [
          {
            "shot_id": "S04-06",
            "intent": {
              "size": "近景",
              "seconds": 3,
              "action": "沈砚右手抄起墙边的锈钢管，横着格开第二刀，钢管和刀刃撞出一串火星。",
              "characters": ["沈砚", "周烈"],
              "dialogue_lines": [],
              "must_keep": ["钢管在沈砚右手", "火星溅开"]
            },
            "takes": [
