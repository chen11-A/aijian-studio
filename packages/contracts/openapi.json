{
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "const": "9:16",
            "default": "9:16",
            "title": "Aspect Ratio",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source_language": {
            "const": "zh-CN",
            "default": "zh-CN",
            "title": "Source Language",
            "type": "string"
          },
          "target_duration_seconds": {
            "default": 90,
            "maximum": 180.0,
            "minimum": 30.0,
            "title": "Target Duration Seconds",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "Stable machine-readable error details.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "retryable"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Error envelope shared by all HTTP boundaries.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthData": {
        "additionalProperties": false,
        "description": "Stable service identity returned by the health endpoint.",
        "properties": {
          "service": {
            "const": "aijian-api",
            "default": "aijian-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Versioned health response envelope.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportTextSourceRequest": {
        "additionalProperties": false,
        "properties": {
          "content_base64": {
            "minLength": 4,
            "title": "Content Base64",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "media_type": {
            "const": "text/plain",
            "default": "text/plain",
            "title": "Media Type",
            "type": "string"
          }
        },
        "required": [
          "filename",
          "content_base64"
        ],
        "title": "ImportTextSourceRequest",
        "type": "object"
      },
      "ProjectData": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "const": "9:16",
            "title": "Aspect Ratio",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "source_language": {
            "const": "zh-CN",
            "title": "Source Language",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "archived"
            ],
            "title": "Status",
            "type": "string"
          },
          "target_duration_seconds": {
            "title": "Target Duration Seconds",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "aspect_ratio",
          "target_duration_seconds",
          "source_language",
          "status",
          "revision",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectData",
        "type": "object"
      },
      "ProjectListResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProjectData"
            },
            "title": "Data",
            "type": "array"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "ProjectListResponse",
        "type": "object"
      },
      "ProjectResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProjectData"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "ProjectResponse",
        "type": "object"
      },
      "SourceBlockData": {
        "additionalProperties": false,
        "properties": {
          "chapter_index": {
            "title": "Chapter Index",
            "type": "integer"
          },
          "content_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Sha256",
            "type": "string"
          },
          "id": {
            "pattern": "^srcb_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "chapter_heading",
              "paragraph"
            ],
            "title": "Kind",
            "type": "string"
          },
          "normalized_end_byte": {
            "title": "Normalized End Byte",
            "type": "integer"
          },
          "normalized_start_byte": {
            "title": "Normalized Start Byte",
            "type": "integer"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ordinal",
          "kind",
          "chapter_index",
          "text",
          "normalized_start_byte",
          "normalized_end_byte",
          "content_sha256"
        ],
        "title": "SourceBlockData",
        "type": "object"
      },
      "SourceDocumentData": {
        "additionalProperties": false,
        "properties": {
          "block_count": {
            "title": "Block Count",
            "type": "integer"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/SourceBlockData"
            },
            "title": "Blocks",
            "type": "array"
          },
          "byte_size": {
            "title": "Byte Size",
            "type": "integer"
          },
          "chapter_count": {
            "title": "Chapter Count",
            "type": "integer"
          },
          "encoding": {
            "const": "utf-8",
            "title": "Encoding",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "pattern": "^src_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "imported_at": {
            "format": "date-time",
            "title": "Imported At",
            "type": "string"
          },
          "media_type": {
            "const": "text/plain",
            "title": "Media Type",
            "type": "string"
          },
          "project_id": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "title": "Project Id",
            "type": "string"
          },
          "raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Raw Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "filename",
          "media_type",
          "encoding",
          "byte_size",
          "raw_sha256",
          "imported_at",
          "chapter_count",
          "block_count",
          "blocks"
        ],
        "title": "SourceDocumentData",
        "type": "object"
      },
      "SourceDocumentListResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/SourceDocumentSummaryData"
            },
            "title": "Data",
            "type": "array"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SourceDocumentListResponse",
        "type": "object"
      },
      "SourceDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SourceDocumentData"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SourceDocumentResponse",
        "type": "object"
      },
      "SourceDocumentSummaryData": {
        "additionalProperties": false,
        "properties": {
          "block_count": {
            "title": "Block Count",
            "type": "integer"
          },
          "byte_size": {
            "title": "Byte Size",
            "type": "integer"
          },
          "chapter_count": {
            "title": "Chapter Count",
            "type": "integer"
          },
          "encoding": {
            "const": "utf-8",
            "title": "Encoding",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "pattern": "^src_[0-9a-f]{32}$",
            "title": "Id",
            "type": "string"
          },
          "imported_at": {
            "format": "date-time",
            "title": "Imported At",
            "type": "string"
          },
          "media_type": {
            "const": "text/plain",
            "title": "Media Type",
            "type": "string"
          },
          "project_id": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "title": "Project Id",
            "type": "string"
          },
          "raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Raw Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "filename",
          "media_type",
          "encoding",
          "byte_size",
          "raw_sha256",
          "imported_at",
          "chapter_count",
          "block_count"
        ],
        "title": "SourceDocumentSummaryData",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Aijian Studio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Sidecar authentication required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Sidecar request boundary rejected"
          }
        },
        "summary": "Health"
      }
    },
