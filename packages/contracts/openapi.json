                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Source already imported"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
